# Server Port (auto-assigned by cloud hosts like Render/Railway)
PORT=8081

# PostgreSQL Database (Neon / Supabase / Railway / RDS)
DATABASE_URL=jdbc:postgresql://<host>/<database>?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_database_password_here

# Security
JWT_SECRET=super_secret_jwt_key_that_should_be_long_enough_for_hs256_algorithm
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-production-app.vercel.app

# Optional AI & IoT Keys
AI_API_KEY=your_ai_api_key_here
DEVICE_API_KEY=esp32_smartwaste_secret_key_2025

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-firebase-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Or provide the entire JSON string directly in cloud env:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

